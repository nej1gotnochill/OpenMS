# Copy this file to config.env and edit the values below:
#
#   cp config.env.example config.env
#
# config.env itself is gitignored on purpose — it holds machine-specific
# paths that should never be committed.

# --- Paths (edit these) ------------------------------------------------------
QUANTMS_DIR=/absolute/path/to/quantms
DATASET_DIR=/absolute/path/to/proteobench/dataset
MZML_DIR=                              # optional; defaults to DATASET_DIR
FASTA=/absolute/path/to/ProteoBenchFASTA_MixedSpecies_HYE.fasta
SDRF=/absolute/path/to/quantms_design.sdrf.tsv
OUTDIR=/absolute/path/to/benchmark-results

# --- Pipeline behaviour -------------------------------------------------------
PROFILE=dev,docker
SEARCH_ENGINE=comet
ENABLE_RESCORING=false
DRY_RUN=true
NEXTFLOW_EXTRA_ARGS=

# --- Optional checks ----------------------------------------------------------
CHECK_DISK_SPACE=false
MIN_DISK_SPACE_GB=50
CHECK_INTERNET=false
SKIP_DEPENDENCY_CHECK=false
