# =============================================================================
# benchmark_quantms.sh — configuration
# Edit the values below, then run:  bash benchmark_quantms.sh
# All values are sourced by the script; every parameter is overridable here.
# =============================================================================

# --- Paths -------------------------------------------------------------------

# Directory containing the bigbio/quantms clone (Nextflow pipeline root).
QUANTMS_DIR="/c/Users/Divyansh Lalotra/quantms"

# Root folder of the benchmark dataset (mzML files, or the download target later).
DATASET_DIR="/c/Users/Divyansh Lalotra/benchmark-data/LFQ_Quant_DDA_QExactive"

# Sub-directory with the .mzML files (optional; defaults to DATASET_DIR).
MZML_DIR=""

# Search database (FASTA).
FASTA="/c/Users/Divyansh Lalotra/benchmark-data/ProteoBenchFASTA_MixedSpecies_HYE.fasta"

# Sample/design file (SDRF) — quantms' primary input.
SDRF="/c/Users/Divyansh Lalotra/benchmark-data/quantms_design.sdrf.tsv"

# Where quantms writes its results (passed as --outdir).
OUTDIR="/c/Users/Divyansh Lalotra/benchmark-data/results_benchmark"

# --- Pipeline behaviour ------------------------------------------------------

# Nextflow profiles, comma-separated. Timo's requirement: dev,docker
# (dev = current OpenMS dev container; docker = container execution).
PROFILE="dev,docker"

# Search engine(s), comma-separated. Supported: comet, sage, msgf, ...
# ProteoBench / Timo comparison: comet.
SEARCH_ENGINE="comet"

# Rescoring switch: true  -> MS²Rescore path (--ms2features_enable true)
#                  false -> Percolator only  (--ms2features_enable false)
ENABLE_RESCORING="false"

# Parameter files for identification / quantification (optional).
# If non-empty, passed as --id_parameters / --quant_parameters.
# ID_PARAMETERS=""
# QUANT_PARAMETERS=""

# Dry run: print the nextflow command without executing it.
# Set to false only once the dataset is actually on disk and you want to run.
DRY_RUN="true"

# Extra flags passed through to nextflow (e.g. "-resume").
NEXTFLOW_EXTRA_ARGS=""

# --- Logging / housekeeping ---------------------------------------------------

# Where run.log / quantms.log / summary.log are written.
LOG_DIR="/c/Users/Divyansh Lalotra/OneDrive/Desktop/GSOC NOTES/benchmark-prototype/logs"

# Where key outputs are copied after a successful run.
OUTPUTS_DIR="/c/Users/Divyansh Lalotra/OneDrive/Desktop/GSOC NOTES/benchmark-prototype/outputs"

# Optional checks: set to true to enable
CHECK_DISK_SPACE="false"
MIN_DISK_SPACE_GB="50"
CHECK_INTERNET="false"          # only relevant once downloads are implemented

# --- Runtime overrides (advanced) ---------------------------------------------
# Set to "true" to bypass the dependency check (development only).
SKIP_DEPENDENCY_CHECK="false"
